<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!--
            Instancia donde corren los tests de integración. Los tests BORRAN y vuelven a crear la base
            BATALLANAVAL con Script.sql (y hacen backup/restore sobre ella), así que tiene que ser una
            instancia de prueba, NO la que usa la aplicación. Por defecto se usa LocalDB, que viene con
            Visual Studio. Como resguardo, si en esa instancia ya hay una base BATALLANAVAL que no
            crearon los tests, no se toca y los tests fallan con un aviso.
        -->
        <add name="BATALLANAVAL" connectionString="Data Source=(localdb)\MSSQLLocalDB; Initial Catalog=BATALLANAVAL; Integrated Security=SSPI; Current Language=Spanish;" providerName="System.Data.SqlClient" />
        <add name="MASTER" connectionString="Data Source=(localdb)\MSSQLLocalDB; Initial Catalog=master; Integrated Security=SSPI; Current Language=Spanish;" providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
